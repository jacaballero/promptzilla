# Address of the external LLM backend the container proxies the API path to
# (host:port). Point it at your Ollama (provider "ollama", e.g. host:11434) or
# vLLM (provider "openai", e.g. 10.142.14.169:8002). Copy this file to .env and
# set the real value. .env is gitignored.
LLM_UPSTREAM=your-llm-host:11434

# Host port the game is served on (http://localhost:<WEB_PORT>). Defaults to 8080.
WEB_PORT=8080

# --- xAPI Learning Record Store (SQL LRS + Postgres) -------------------------
# Host port of the LRS (admin UI at http://<host>:<LRS_PORT>/admin and API at /xapi).
LRS_PORT=8081
# URLs (comma-separated, no spaces) from which you open the LRS admin UI.
# Defaults to http://localhost:<LRS_PORT>,http://127.0.0.1:<LRS_PORT>; add the server's
# address when deployed, e.g. http://promptzilla.uca.es:8081
#LRS_ALLOWED_ORIGINS=http://localhost:8081,http://my-server:8081
# Host port and bind address of Postgres (127.0.0.1 = only reachable from this host).
LRS_DB_PORT=5433
LRS_DB_BIND=127.0.0.1

# Admin UI account (seeded on first start).
LRS_ADMIN_USER=admin
LRS_ADMIN_PASS=change-me
# xAPI credentials used by the game proxy and the exporter (seeded on first start).
LRS_API_KEY=change-me-key
LRS_API_SECRET=change-me-secret
# Must equal base64 of "LRS_API_KEY:LRS_API_SECRET":  printf 'key:secret' | base64
LRS_BASIC_AUTH=Y2hhbmdlLW1lLWtleTpjaGFuZ2UtbWUtc2VjcmV0
# Postgres password for the LRS database.
LRS_DB_PASSWORD=change-me-db

# Owner of the files written by `docker compose run --rm analytics` (Linux: id -u / id -g).
#ANALYTICS_UID=1000
#ANALYTICS_GID=1000
