# Address of the external LLM backend the container proxies the API path to
# (host:port). Point it at your Ollama (provider "ollama", e.g. host:11434) or
# vLLM (provider "openai", e.g. 10.142.14.169:8002). Copy this file to .env and
# set the real value. .env is gitignored.
LLM_UPSTREAM=your-llm-host:11434

# Host port the game is served on (http://localhost:<WEB_PORT>). Defaults to 8080.
WEB_PORT=8080
