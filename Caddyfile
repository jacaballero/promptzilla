# HTTP on :80. The browser only talks to this container (same origin); the
# container forwards the API path to the external LLM backend (server -> server),
# so CORS and mixed-content never come into play. For public HTTPS, replace `:80`
# with your domain (Caddy then provisions certificates automatically via ACME).
:80 {
	root * /srv
	encode gzip

	# Forward the active backend's API path to LLM_UPSTREAM. Only one provider is
	# used per deployment (chosen in config.js), so both matchers share one upstream.
	# Ollama uses /api/generate; OpenAI-compatible backends (e.g. vLLM) use /v1/*.
	@llm path /api/* /v1/*
	reverse_proxy @llm {$LLM_UPSTREAM:127.0.0.1:11434} {
		# Disable response buffering so streaming NDJSON/SSE flows chunk by chunk.
		flush_interval -1
	}

	# xAPI: only statement POSTs reach the LRS; credentials are added here so they
	# never reach the browser. Any other /xapi/* request (e.g. GET) is refused.
	@xapi {
		method POST
		path /xapi/statements
	}
	handle @xapi {
		request_body {
			max_size 256KB
		}
		reverse_proxy {$LRS_UPSTREAM:lrs:8080} {
			header_up Authorization "Basic {$LRS_BASIC_AUTH}"
			header_up X-Experience-API-Version "1.0.3"
			# The game posts as text/plain to avoid CORS preflights.
			header_up Content-Type "application/json"
			header_up -Origin
		}
	}
	handle /xapi/* {
		respond 404
	}

	# Revalidate code on every load (cheap 304s) so deploys show up without a hard reload.
	@code path / *.html *.js *.css
	header @code Cache-Control "no-cache"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=86400"

	file_server
}
