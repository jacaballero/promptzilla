# HTTP on :80. The browser only talks to this container (same origin); the
# container forwards /api/* to the external Ollama (server -> server), so CORS
# and mixed-content never come into play. For public HTTPS, replace `:80` with
# your domain (Caddy then provisions certificates automatically via ACME).
:80 {
	root * /srv
	encode gzip

	# Forward /api/* to Ollama, keeping the path (Ollama expects /api/generate).
	@api path /api/*
	reverse_proxy @api {$OLLAMA_UPSTREAM} {
		# Disable response buffering so streaming NDJSON flows chunk by chunk.
		flush_interval -1
	}

	file_server
}
